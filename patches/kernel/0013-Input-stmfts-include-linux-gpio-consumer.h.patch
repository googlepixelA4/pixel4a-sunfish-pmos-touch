From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: user <user@example.invalid>
Date: Mon, 28 Sep 2026 00:00:00 +0000
Subject: [PATCH 13/14] Input: stmfts - include linux/gpio/consumer.h

The FTS5 series uses devm_gpiod_get_optional(), gpiod_set_value_cansleep()
and GPIOD_OUT_HIGH for the reset and mode-switch GPIOs, but does not
include <linux/gpio/consumer.h>. Nothing else stmfts.c includes pulls it
in, so the build fails with implicit declaration errors.
---
 drivers/input/touchscreen/stmfts.c | 1 +
 1 file changed, 1 insertion(+)

diff --git a/drivers/input/touchscreen/stmfts.c b/drivers/input/touchscreen/stmfts.c
index 9a2806d69..806780b11 100644
--- a/drivers/input/touchscreen/stmfts.c
+++ b/drivers/input/touchscreen/stmfts.c
@@ -8,6 +8,7 @@
  */
 
 #include <linux/delay.h>
+#include <linux/gpio/consumer.h>
 #include <linux/i2c.h>
 #include <linux/input/mt.h>
 #include <linux/input/touchscreen.h>
